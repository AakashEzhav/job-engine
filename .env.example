# ============================================================
# GLOBAL JOB ENGINE — ENVIRONMENT VARIABLES
# ============================================================
# Copy this to .env.local and fill in your real values.
# NEVER commit .env.local to GitHub.

# ─── REQUIRED ────────────────────────────────────────────────
# Supabase free database — https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJ...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJ...

# Your secret key for triggering scrapes (make up any long string)
CRON_SECRET=any_long_random_string_abc123xyz789

# ─── OPTIONAL (free, gets you MORE jobs) ─────────────────────

# Adzuna API — aggregates LinkedIn + Indeed data legally
# Free: 250 requests/day. Sign up at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJobs.gov API — US government tech jobs, high visa chance
# Free, instant. Register at https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Google Custom Search API — extracts structured job data Google already indexed
# Free: 100 searches/day. Get at https://console.cloud.google.com
# Also create a Custom Search Engine at https://programmablesearchengine.google.com
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Bing Search API — alternative search indexing, 1000 free calls/month
# Get at https://azure.microsoft.com/en-us/products/ai-services/bing-search
BING_SEARCH_API_KEY=

# ─── NO KEY NEEDED (works automatically) ─────────────────────
# LinkedIn Mobile API, Indeed Internal, Glassdoor GraphQL,
# Greenhouse ATS, Lever ATS, Archive.org CDX,
# RemoteOK, Remotive, Arbeitnow, Himalayas, Jobicy, TheMuse,
# DevITJobs, WeWorkRemotely, WorkingNomads,
# HackerNews, Reddit, ProductHunt, YCombinator, TechCrunch
